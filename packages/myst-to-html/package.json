{
  "name": "myst-to-html",
  "version": "1.8.0",
  "description": "Export from MyST mdast to HTML",
  "author": "Franklin Koch <franklin@curvenote.com>",
  "homepage": "https://github.com/jupyter-book/mystmd/tree/main/packages/myst-to-html",
  "license": "MIT",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "keywords": [
    "myst-plugin",
    "tex",
    "latex"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jupyter-book/mystmd.git"
  },
  "scripts": {
    "clean": "rimraf dist",
    "lint": "eslint \"src/**/*.ts\" -c eslint.config.mjs --max-warnings 1",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "build:esm": "tsc",
    "build": "npm-run-all -l clean -p build:esm"
  },
  "bugs": {
    "url": "https://github.com/jupyter-book/mystmd/issues"
  },
  "dependencies": {
    "classnames": "^2.3.2",
    "hast-util-to-mdast": "^10.1.2",
    "markdown-it": "^13.0.1",
    "@types/markdown-it": "^13.0.1",
    "mdast-util-find-and-replace": "^3.0.3",
    "mdast-util-to-hast": "^13.2.1",
    "myst-common": "^1.12.0",
    "myst-spec": "^0.0.7",
    "rehype-format": "^5.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-stringify": "^10.0.1",
    "unified": "^11.0.5",
    "unist-builder": "^4.0.0",
    "unist-util-find-after": "^5.0.0",
    "unist-util-remove": "^4.0.0",
    "unist-util-select": "^5.1.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "eslint": "^10.14.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "hastscript": "^9.0.1",
    "js-yaml": "^4.1.0"
  }
}

{
  "name": "mystmd",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "docs": "npm-run-all -l build --parallel dev docs:run",
    "docs:run": "cd docs && bun ../packages/mystmd/dist/myst.cjs start",
    "clean": "turbo run clean --parallel && find . -name '.turbo' -type d -prune -exec rimraf '{}' +",
    "link": "npm link -w packages/mystmd",
    "lint": "turbo run lint",
    "lint:format": "oxfmt --check \"**/*.{ts,tsx,md}\"",
    "lint:circular": "madge -c packages/*/src/*",
    "test": "turbo run test",
    "format": "oxfmt \"**/*.{ts,tsx,md}\"",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "publish": "bun run clean && bun run build -- --force && changeset publish && git push --follow-tags",
    "publish:ci": "bun run build && changeset publish && git push --follow-tags",
    "install-pre-commit": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.6.2",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "esbuild": "^0.25.10",
    "eslint": "^10.14.0",
    "eslint-config-curvenote": "^0.0.4",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "7.37.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "madge": "^6.1.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.78.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.10",
  "lint-staged": {
    "!(*.spec).ts": "eslint --config ./eslint.config.cjs --ignore-pattern 'worktrees' --fix",
    "*.{js,jsx,ts,tsx,md,html,css,json}": "prettier --write"
  }
}
